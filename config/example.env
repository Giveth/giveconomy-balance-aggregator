DATABASE_HOST=localhost
DATABASE_PORT=5532
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=balance-aggregator

SUBGRAPH_PAGINATION_LIMIT=5000

# Key for subgraphs hosted on The Graph's decentralised gateway
# (gateway.thegraph.com), which rejects unauthenticated queries. Leave blank if
# every configured subgraph is self-hosted. A network can override this with its
# own `subgraphApiKey` in the blockchain config.
SUBGRAPH_API_KEY=

BLOCKCHAIN_CONFIG_FILE_NAME=test.yaml
