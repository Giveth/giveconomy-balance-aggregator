DATABASE_HOST=localhost
DATABASE_PORT=5532
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=balance-aggregator

SUBGRAPH_PAGINATION_LIMIT=5000

# Key for subgraphs hosted on The Graph's decentralised gateway
# (gateway.thegraph.com), which rejects unauthenticated queries. Leave blank if
# every configured subgraph is self-hosted. A network can override this with its
# own `subgraphApiKey` in the blockchain config.
SUBGRAPH_API_KEY=

# Hosts SUBGRAPH_API_KEY may be sent to, comma separated. The shared key is only
# attached to a request whose URL host is on this list, so a deployment mixing
# gateway-hosted subgraphs with Studio- or self-hosted ones does not hand the
# gateway credential to the others. A per-network `subgraphApiKey` is an
# explicit choice and is always sent, regardless of this list. Defaults to
# gateway.thegraph.com and gateway-arbitrum.network.thegraph.com when blank.
SUBGRAPH_API_KEY_HOSTS=

BLOCKCHAIN_CONFIG_FILE_NAME=test.yaml
